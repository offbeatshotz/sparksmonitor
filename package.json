{
  "name": "sparks-monitor-tracker",
  "version": "1.0.0",
  "description": "Unified Spark Monitor and Car Tracker Pro",
  "main": "index.html",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./style.css -o ./output.css",
    "watch:css": "tailwindcss -i ./style.css -o ./output.css --watch",
    "start": "npm run watch:css & live-server .",
    "capacitor:sync": "npx cap sync",
    "capacitor:open:android": "npx cap open android",
    "capacitor:open:ios": "npx cap open ios",
    "capacitor:add:android": "npx cap add android",
    "capacitor:add:ios": "npx cap add ios"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/app": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/geolocation": "^5.0.0",
    "@capacitor/haptics": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "@capacitor/keyboard": "^5.0.0",
    "@capacitor/status-bar": "^5.0.0",
    "@mauron85/cordova-plugin-background-geolocation": "^3.1.0",
    "cordova-plugin-mauron85-background-geolocation": "^3.0.0-alpha.50"
  }
}
